# Local SQLite database for throwaway prototype data (constitution §2, §7).
# This is NOT a secret, but it follows the env convention: copy to .env before running.
#
#   cp .env.example .env
#
# The seed script resets data with a file-level delete and refuses to run unless
# DATABASE_URL is a local "file:" SQLite URL, so it can never wipe a real database.
DATABASE_URL="file:./dev.db"

# Runtime stays prototype-safe until the durable database and staff auth gate
# are complete. Never set pilot + ready on the existing demo deployment.
APP_MODE="prototype"
PRODUCTION_FOUNDATION_READY="false"
PILOT_ALLOWED_STATES=""
SUPPORT_EMAIL=""

# Optional (B20): enables the guarded Haiku extraction pass for fuzzy fields.
# Server-only — never expose to the client bundle. Absent => pure-local extraction.
# ANTHROPIC_API_KEY="sk-ant-..."
