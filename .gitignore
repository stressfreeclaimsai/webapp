# dependencies
/node_modules

# next.js
/.next
/out
next-env.d.ts

# production
/build

# local PostgreSQL data lives in the named Docker volume, never the repository
# historical prototype SQLite files may remain in an existing checkout
/prisma/dev*.db
/prisma/dev*.db-journal
*.db
*.db-journal

# env — never commit real env files; keep the example
.env
.env.*
!.env.example

# test artifacts
/test-results
/playwright-report
/blob-report
/playwright/.cache

# typescript build info
*.tsbuildinfo

# inbox — friends' raw idea docs never enter repo history
inbox/*
!inbox/.gitkeep
!inbox/README.md

# misc
.DS_Store
*.pem
npm-debug.log*
.vercel
.env*
