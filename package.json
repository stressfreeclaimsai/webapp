{
  "name": "foundry-default-archetype",
  "version": "0.1.0",
  "private": true,
  "description": "Default archetype template for the Foundry prototype engine: a single-user, customer-testable web prototype scaffold.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:cleanup": "tsx scripts/cleanup-expired-drafts.ts",
    "db:setup": "npm run db:up && npm run db:migrate && npm run seed",
    "seed": "tsx prisma/seed.ts",
    "vercel-build": "npm run build",
    "test": "playwright test",
    "verify": "tsx scripts/verify.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.5",
    "@prisma/client": "6.19.3",
    "chrono-node": "^2.10.1",
    "fuse.js": "^7.5.0",
    "next": "15.5.19",
    "parse-address": "^1.1.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.5",
    "@playwright/test": "1.61.0",
    "@tailwindcss/postcss": "4.3.1",
    "@types/node": "22.19.21",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "15.5.19",
    "prettier": "3.8.4",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.1",
    "tsx": "4.22.4",
    "typescript": "5.9.3"
  }
}
