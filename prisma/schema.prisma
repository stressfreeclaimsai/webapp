// ============================================================================
// StressFreeClaim.ai — production-track data model.
//
// Design rule:
// - Stable, filterable operational facts are explicit columns.
// - User-testing additions begin in `extraFields` with an `intakeVersion`.
// - Open-ended vocabularies (status, role, damage item, notification kind) are
//   strings validated by application code, not PostgreSQL enums. This avoids a
//   migration every time prototype feedback changes a workflow label.
// - Submitted Claim rows are self-contained snapshots. No homeowner account is
//   required for the private pilot.
// ============================================================================

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model ClaimDraft {
  id                    String @id @default(cuid())
  continuationTokenHash String @unique @db.Char(64)
  intakeVersion         Int    @default(1)
  status                String @default("in_progress") @db.VarChar(32)

  claimantName      String?
  propertyAddress   String?
  stateOfLoss       String?   @db.VarChar(2)
  dateOfLoss        DateTime?
  insurerName       String?
  itemsDamaged      String[]  @default([])
  phone             String?
  email             String?
  policyNumber      String?
  deductible        String?
  damageDescription String?
  optionalsOffered  Boolean   @default(false)

  // Safe extension seam for temporary, non-query-critical intake experiments.
  // Promote a field to a typed column once user evidence makes it durable.
  extraFields Json @default("{}")

  submittedClaimId String? @unique
  submittedClaim   Claim?  @relation("SubmittedDraft", fields: [submittedClaimId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime

  @@index([status, expiresAt])
  @@index([stateOfLoss])
  @@index([updatedAt])
}

model Claim {
  id            String @id @default(cuid())
  referenceCode String @unique @db.VarChar(24)
  submissionKey String @unique @db.VarChar(128)
  intakeVersion Int    @default(1)
  source        String @default("web_intake") @db.VarChar(40)
  status        String @default("new") @db.VarChar(32)

  // Immutable-at-submit homeowner-confirmed intake snapshot.
  claimantName      String
  propertyAddress   String
  stateOfLoss       String   @db.VarChar(2)
  phone             String
  email             String
  insurerName       String
  policyNumber      String?
  deductible        String?
  dateOfLoss        DateTime
  itemsDamaged      String[] @default([])
  damageDescription String   @default("")

  // See ClaimDraft.extraFields. Kept on the submitted snapshot so experiments
  // remain intelligible even after the originating draft expires.
  extraFields Json @default("{}")

  sourceDraft            ClaimDraft?            @relation("SubmittedDraft")
  assignments            ClaimAssignment[]
  notes                  ClaimNote[]
  auditEvents            AuditEvent[]
  notificationDeliveries NotificationDelivery[]

  submittedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  closedAt    DateTime?

  @@index([status, submittedAt])
  @@index([stateOfLoss, submittedAt])
  @@index([claimantName])
  @@index([email])
}

model StaffUser {
  id              String  @id @default(cuid())
  externalSubject String  @unique @db.VarChar(191)
  email           String  @unique
  displayName     String
  role            String  @default("standard") @db.VarChar(32)
  isActive        Boolean @default(true)

  assignments     ClaimAssignment[] @relation("AssignmentAssignee")
  assignmentsMade ClaimAssignment[] @relation("AssignmentCreator")
  notes           ClaimNote[]
  auditEvents     AuditEvent[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastSeenAt DateTime?

  @@index([isActive])
}

model ClaimAssignment {
  id String @id @default(cuid())

  claim        Claim      @relation(fields: [claimId], references: [id], onDelete: Cascade)
  claimId      String
  assignee     StaffUser  @relation("AssignmentAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  assigneeId   String
  assignedBy   StaffUser? @relation("AssignmentCreator", fields: [assignedById], references: [id], onDelete: SetNull)
  assignedById String?

  assignedAt   DateTime  @default(now())
  unassignedAt DateTime?

  @@index([claimId, unassignedAt])
  @@index([assigneeId, unassignedAt])
}

model ClaimNote {
  id String @id @default(cuid())

  claim    Claim     @relation(fields: [claimId], references: [id], onDelete: Cascade)
  claimId  String
  author   StaffUser @relation(fields: [authorId], references: [id], onDelete: Restrict)
  authorId String
  body     String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([claimId, createdAt])
}

model AuditEvent {
  id String @id @default(cuid())

  claim   Claim?     @relation(fields: [claimId], references: [id], onDelete: SetNull)
  claimId String?
  actor   StaffUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId String?

  actorType  String @default("system") @db.VarChar(24)
  action     String @db.VarChar(80)
  entityType String @db.VarChar(48)
  entityId   String

  // Must contain identifiers and change metadata only—never raw claim facts.
  metadata Json @default("{}")

  createdAt DateTime @default(now())

  @@index([claimId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

model NotificationDelivery {
  id String @id @default(cuid())

  claim   Claim?  @relation(fields: [claimId], references: [id], onDelete: Cascade)
  claimId String?

  kind              String  @db.VarChar(64)
  channel           String  @default("email") @db.VarChar(24)
  recipientAddress  String
  status            String  @default("pending") @db.VarChar(32)
  idempotencyKey    String  @unique @db.VarChar(191)
  providerMessageId String? @unique @db.VarChar(191)
  attempts          Int     @default(0)
  lastErrorCode     String? @db.VarChar(80)

  scheduledAt DateTime  @default(now())
  sentAt      DateTime?
  deliveredAt DateTime?
  failedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, scheduledAt])
  @@index([claimId, kind])
}
